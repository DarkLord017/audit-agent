# Copy to .env and fill in.  `make secret` generates PROXY_SECRET_KEY.
# .env is gitignored -- never commit a real key.

# The real Anthropic key. It never enters a worker container: the API
# seals it into a per-job token and the proxy swaps it back on the way out.
ANTHROPIC_API_KEY=sk-ant-...

# Fernet key that seals those tokens.  make secret
PROXY_SECRET_KEY=

POSTGRES_PASSWORD=evmbench
RABBITMQ_USER=evmbench
RABBITMQ_PASSWORD=evmbench

# How many audits run at once. Each is a container with 1 GB and half a core.
INSTANCER_CONCURRENCY=3
JOB_TIMEOUT_SECONDS=10800

WORKER_IMAGE_SOLIDITY=evmbench/worker-solidity:latest
