# Copy to .env and fill in.  `make env` does that and generates the secret.
# .env is gitignored -- never commit a real key.

# The real Anthropic key. It never enters a worker container: the API seals
# it into a per-job token and the proxy swaps it back on the way out.
ANTHROPIC_API_KEY=sk-ant-...

# Only for identity-linked keys. Those are scoped to a workspace, and the
# API rejects any request that does not name one:
#   400 anthropic-workspace-id is required when authenticating with an
#   identity-linked API key
# Find it in the Anthropic Console URL: /workspaces/<this-part>/...
# Leave blank for an ordinary key.
ANTHROPIC_WORKSPACE_ID=

# Fernet key that seals the per-job tokens.  make secret
PROXY_SECRET_KEY=

POSTGRES_PASSWORD=evmbench
RABBITMQ_USER=evmbench
RABBITMQ_PASSWORD=evmbench

# Per-worker ceilings. The auditor skill runs twelve subagents at once;
# 1g/0.5cpu got the container OOM-killed mid-audit.
WORKER_MEMORY=4g
WORKER_CPUS=3

# How many audits run at once. Multiply the ceilings above by this to see
# what the host needs.
INSTANCER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=10800

WORKER_IMAGE_SOLIDITY=evmbench/worker-solidity:latest

# The worker must be amd64: solc-select ships linux-amd64 binaries only.
# Change this only if you also rebuild the images for that platform
# (PLATFORM in the Makefile).
WORKER_PLATFORM=linux/amd64
